@page
@model MessagingApp.Pages.Chat.IndexModel
@{
    ViewData["Title"] = Model.InitialFeature switch
    {
        "calls" => "Calls",
        "statuses" => "Status",
        "communities" => "Communities",
        "media" => "Shared media",
        _ => "Chats"
    };

    string SharePreview(string? content)
    {
        if (string.IsNullOrWhiteSpace(content)) return "No messages yet";
        var raw = content.Trim();
        if (!raw.StartsWith("{", StringComparison.Ordinal)) return content;
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(raw);
            var root = doc.RootElement;
            string Field(string name) => root.TryGetProperty(name, out var value) && value.ValueKind == System.Text.Json.JsonValueKind.String ? value.GetString() ?? "" : "";
            return (root.TryGetProperty("wa", out var kind) ? kind.GetString() : null) switch
            {
                "voice" => "Voice message",
                "contact" => "Contact: " + (Field("name") is { Length: > 0 } name ? name : Field("username")),
                "poll" => "Poll: " + Field("question"),
                "event" => "Event: " + Field("title"),
                "catalogue" => "Catalogue: " + Field("name"),
                "sticker" => Field("caption") is { Length: > 0 } caption ? caption : "Sticker",
                _ => content
            };
        }
        catch { return content; }
    }
}

<div id="chat-config"
     data-user-id="@Model.CurrentUserId"
     data-display-name="@Model.CurrentUser?.DisplayName"
     data-username="@Model.CurrentUser?.Username"
     data-contact-link="@Model.ContactLink"
     data-open-scanner="@(Model.OpenScanner ? "true" : "false")"
     data-initial-conv-id="@Model.InitialConversationId"
     data-initial-feature="@Model.InitialFeature"
     data-initial-community="@Model.InitialCommunityId"
     class="visually-hidden">
</div>

<form id="anti-forgery-form" class="visually-hidden">
    @Html.AntiForgeryToken()
</form>

<div class="app-canvas">
    <div id="app-frame" class="app-frame">

        @await Html.PartialAsync("_NavigationRail", Model.CurrentUser)

        <aside id="sidebar-column" class="sidebar">
            <div class="pane-head">
                <h1 class="pane-title">WhatsAppSharp</h1>
                <div class="head-actions">
                    <a asp-page="/Account/Settings" class="icon-btn" aria-label="Settings" title="Settings"><i data-lucide="ellipsis-vertical"></i></a>
                    <button type="button" class="icon-btn" onclick="openQrScanner()" title="Scan QR code" aria-label="Scan QR code"><i data-lucide="scan-line"></i></button>
                    <button type="button" class="icon-btn new-chat-action" onclick="openNewChatModal()" title="New chat"><i data-lucide="message-square-plus"></i></button>
                </div>
            </div>

            <nav class="feature-nav-mobile" aria-label="More features"><button type="button" onclick="openFeature('calls')"><i data-lucide="phone"></i>Calls</button><button type="button" onclick="openFeature('statuses')"><i data-lucide="circle-dashed"></i>Status</button><button type="button" onclick="openFeature('communities')"><i data-lucide="network"></i>Communities</button><button type="button" onclick="openFeature('media')"><i data-lucide="images"></i>Media</button></nav><div class="search-wrap">
                <div class="search-field">
                    <i data-lucide="search"></i>
                    <input id="search-conversations-input" type="search" placeholder="Search or start a new chat" aria-label="Search chats" autocomplete="off" />
                </div>
            </div>

            <div class="filters" role="group" aria-label="Filter chats">
                <button type="button" class="filter-chip is-on" data-filter="all" onclick="setConvFilter('all', this)">All</button>
                <button type="button" class="filter-chip" data-filter="unread" onclick="setConvFilter('unread', this)">Unread<span id="unread-filter-count"></span></button>
                <button type="button" class="filter-chip" data-filter="favourites" onclick="setConvFilter('favourites', this)">Favourites</button>
                <button type="button" class="filter-chip" data-filter="groups" onclick="setConvFilter('groups', this)">Groups<span id="group-filter-count"></span></button>
                <button type="button" class="filter-chip filter-add" onclick="openNewGroupModal()" aria-label="Create group" title="Create group"><i data-lucide="plus"></i></button>
            </div>
            <div id="connection-status" class="connection-status hidden" role="status" aria-live="polite"></div>

            <div id="conversations-list" class="conv-list">
                @if (Model.Conversations.Count == 0)
                {
                    <div class="empty-list">
                        <p>No chats yet. Start a conversation.</p>
                        <button type="button" class="btn btn-primary" style="width:auto" onclick="openNewChatModal()">New chat</button>
                    </div>
                }
                else
                {
                    @foreach (var c in Model.Conversations)
                    {
                        <div class="conv-item @(c.Id == Model.InitialConversationId ? "is-active" : "") @(c.UnreadCount > 0 ? "has-unread" : "")"
                             role="button"
                             tabindex="0"
                             data-id="@c.Id"
                             data-timestamp="@(c.LastMessageTimestamp.HasValue ? new DateTimeOffset(DateTime.SpecifyKind(c.LastMessageTimestamp.Value, DateTimeKind.Utc)).ToUnixTimeMilliseconds() : 0)"
                             data-other-user-id="@c.OtherUserId"
                             data-online="@(c.IsOnline ? "true" : "false")"
                             data-is-group="@(c.IsGroup ? "true" : "false")"
                             data-member-names="@c.MemberNames"
                             data-unread="@c.UnreadCount"
                             onclick="selectConversation(@c.Id)">
                            <div class="conv-avatar-wrap">
                                <img src="@c.AvatarUrl" class="conv-avatar" alt="" />
                                <span class="online-dot @(c.IsOnline ? "" : "hidden")"></span>
                            </div>
                            <div class="conv-body">
                                <div class="conv-top">
                                    <span class="conv-title">@c.Title</span>
                                    <span class="conv-time">
                                        @(c.LastMessageTimestamp.HasValue ? c.LastMessageTimestamp.Value.ToLocalTime().ToString("HH:mm") : "")
                                    </span>
                                </div>
                                <div class="conv-bottom">
                                    <span class="conv-last-msg">
                                        @if (c.LastMessageSenderId == Model.CurrentUserId)
                                        {
                                            <svg class="conv-preview-ticks @(c.LastMessageIsRead ? "tick-read" : "")" viewBox="0 0 20 14" aria-hidden="true"><path d="m1 7 4 4L14 2m-4 8 2 1 7-9" /></svg>
                                        }
                                        <span class="conv-preview-text">@SharePreview(c.LastMessageContent)</span>
                                    </span>
                                    <span class="unread-badge @(c.UnreadCount > 0 ? "" : "hidden")">@c.UnreadCount</span>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
            <div id="filter-empty" class="empty-list hidden">No chats match this filter.</div>
        </aside>

        <section id="chat-column" class="thread">
            <div id="empty-chat-state" class="thread-empty @(Model.ActiveConversation != null ? "hidden" : "")">
                <div class="welcome-card">
                    <img src="/images/welcome-laptop.svg" class="welcome-illustration" alt="" width="156" height="132" />
                    <h2>Your conversations,<br />all in one place</h2>
                    <p>Send messages, share moments, and stay connected from your computer.</p>
                    <button type="button" class="welcome-primary" onclick="openNewChatModal()">Start a new chat</button>
                </div>
                <div class="welcome-actions">
                    <button type="button" onclick="openNewChatModal()"><span><i data-lucide="user-round-plus"></i></span>New chat</button>
                    <button type="button" onclick="openNewGroupModal()"><span><i data-lucide="users-round"></i></span>New group</button>
                    <a asp-page="/Account/Settings" asp-fragment="settings-app"><span><i data-lucide="download"></i></span>Install app</a>
                </div>
                <div class="thread-empty-foot"><i data-lucide="message-circle"></i> Send and receive messages in real time</div>
            </div>

            <div id="active-chat-container" class="@(Model.ActiveConversation != null ? "" : "hidden")">
                <header class="thread-head">
                    <div class="thread-peer">
                        <button type="button" class="icon-btn back-btn" onclick="switchMobileView('sidebar')" aria-label="Back">
                            <i data-lucide="arrow-left"></i>
                        </button>
                        <img id="chat-header-avatar" src="@(Model.ActiveConversation?.AvatarUrl ?? "/images/avatars/avatar-default.svg")" alt="" />
                        <div class="thread-peer-meta">
                            <div id="chat-header-title" class="thread-peer-name">@(Model.ActiveConversation?.Title ?? "Chat")</div>
                            <div id="chat-header-status" class="thread-peer-status">@(Model.ActiveConversation?.IsOnline == true ? "online" : "offline")</div>
                        </div>
                    </div>
                    <div class="head-actions">
                        <button type="button" class="icon-btn direct-call-action" onclick="startChatCall(false)" aria-label="Voice call" title="Voice call"><i data-lucide="phone"></i></button><button type="button" class="icon-btn direct-call-action" onclick="startChatCall(true)" aria-label="Video call" title="Video call"><i data-lucide="video"></i></button><button id="favourite-chat-btn" type="button" class="icon-btn favourite-chat-action" onclick="toggleConversationFavourite()" aria-pressed="false" aria-label="Add to favourites" title="Add to favourites"><i data-lucide="star"></i></button>
                        <button type="button" class="icon-btn" onclick="toggleChatSearch()" title="Search">
                            <i data-lucide="search"></i>
                        </button>
                        <button type="button" class="icon-btn" onclick="openChatActionsMenu(event)" aria-label="Chat options" title="Chat options" aria-haspopup="menu"><i data-lucide="ellipsis-vertical"></i></button>
                    </div>
                </header>

                <div id="in-chat-search-bar" class="search-drawer hidden">
                    <div class="search-drawer-row">
                        <input id="in-chat-search-input" type="search" placeholder="Search messages"
                               onkeyup="if (event.key === 'Enter') performChatSearch()" />
                        <button type="button" class="btn btn-primary" style="width:auto;height:35px;padding:0 14px" onclick="performChatSearch()">Search</button>
                        <button type="button" class="icon-btn" onclick="toggleChatSearch()" aria-label="Close search">
                            <i data-lucide="x"></i>
                        </button>
                    </div>
                    <div id="in-chat-search-results" class="search-results"></div>
                </div>

                <div id="pinned-message-bar" class="pinned-message-bar hidden">
                    <button type="button" class="pinned-message-link" onclick="openFirstPinnedMessage()"><i data-lucide="pin"></i><span><strong>Pinned message</strong><span id="pinned-message-preview"></span></span></button>
                    <button type="button" class="icon-btn" onclick="showPinnedMessages()" aria-label="View pinned messages"><i data-lucide="chevron-down"></i></button>
                </div>
                <div class="messages-wrap">
                    <div id="messages-container" class="chat-wallpaper"></div>
                    <div id="typing-bubble-container" class="typing-row hidden">
                        <div class="typing-bubble" aria-hidden="true">
                            <span class="typing-dot"></span>
                            <span class="typing-dot"></span>
                            <span class="typing-dot"></span>
                        </div>
                    </div>
                </div>

                <div class="composer">
                    <div id="reply-preview-bar" class="preview-bar hidden">
                        <div>
                            <div class="quote-name" id="reply-preview-sender">Sender</div>
                            <div class="quote-text" id="reply-preview-content">Quoted content</div>
                        </div>
                        <button type="button" class="icon-btn" onclick="cancelReply()" aria-label="Cancel reply">
                            <i data-lucide="x"></i>
                        </button>
                    </div>

                    <div id="attachment-preview-bar" class="preview-bar is-file hidden">
                        <div id="attachment-name-preview">Uploading…</div>
                        <button type="button" class="icon-btn" onclick="clearPendingAttachment()" aria-label="Remove file">
                            <i data-lucide="x"></i>
                        </button>
                    </div>

                    <div id="emoji-picker-container" class="emoji-board hidden" data-emoji-picker role="dialog" aria-label="Emoji"></div>

                    <div id="voice-recorder" class="voice-composer hidden" aria-label="Voice message recorder">
                        <button type="button" class="icon-btn voice-discard" onclick="discardVoiceRecording()" aria-label="Discard recording" title="Discard recording"><i data-lucide="trash-2"></i></button>
                        <span id="voice-record-dot" class="voice-record-dot" aria-hidden="true"></span>
                        <button id="voice-preview-play" type="button" class="icon-btn hidden" onclick="previewVoiceRecording()" aria-label="Play recording" title="Play recording"><i data-lucide="play"></i></button>
                        <output id="voice-record-time" class="voice-record-time" aria-label="Recording duration">0:00</output>
                        <div class="voice-record-wave" aria-hidden="true"><svg viewBox="0 0 192 32" preserveAspectRatio="none"><path id="voice-record-wave-path" d="" /></svg></div>
                        <button id="voice-stop" type="button" class="icon-btn voice-stop" onclick="stopVoiceRecording()" aria-label="Stop and preview recording" title="Stop and preview"><i data-lucide="pause"></i></button>
                        <button id="voice-send" type="button" class="send-btn" onclick="sendVoiceRecording()" aria-label="Send voice message" title="Send voice message"><i data-lucide="send"></i></button>
                        <span id="voice-record-status" class="visually-hidden" role="status" aria-live="polite"></span>
                    </div>
                    <div id="message-composer-row" class="composer-row">
                        <div class="attach-anchor">
                            <button id="attach-toggle" type="button" class="icon-btn" title="Attach" aria-label="Attach" aria-haspopup="menu" aria-expanded="false" aria-controls="attach-menu" onclick="toggleAttachMenu()">
                                <i data-lucide="paperclip"></i>
                            </button>
                            <div id="attach-menu" class="attach-menu hidden" role="menu" aria-label="Attach">
                                <button type="button" class="attach-option" role="menuitem" onclick="pickAttachment('document')"><span class="attach-glyph" style="color:#7f66ff"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18h6c.28 0 .52-.1.71-.29.2-.19.29-.43.29-.71 0-.28-.1-.52-.29-.71A.97.97 0 0 0 15 16H9c-.28 0-.52.1-.71.29A.94.94 0 0 0 8 17c0 .28.1.52.29.71.19.2.43.29.71.29Zm0-4h6c.28 0 .52-.1.71-.29.2-.19.29-.43.29-.71 0-.28-.1-.52-.29-.71A.97.97 0 0 0 15 12H9c-.28 0-.52.1-.71.29A.94.94 0 0 0 8 13c0 .28.1.52.29.71.19.2.43.29.71.29Zm-3 8c-.55 0-1.02-.2-1.41-.59-.4-.39-.59-.86-.59-1.41V4c0-.55.2-1.02.59-1.41C4.98 2.19 5.45 2 6 2h7.18a1.97 1.97 0 0 1 1.4.58l4.85 4.84a1.94 1.94 0 0 1 .57 1.4V20c0 .55-.2 1.02-.59 1.41-.39.4-.86.59-1.41.59H6Zm7-14c0 .28.1.52.29.71.19.2.43.29.71.29h4l-5-5v4Z"/></svg></span><span>Document</span></button>
                                <button type="button" class="attach-option" role="menuitem" onclick="pickAttachment('media')"><span class="attach-glyph" style="color:#007bfc"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.25 12.5 12.1 11a.48.48 0 0 0-.4-.2c-.17 0-.3.07-.4.2l-1.68 2.2a.47.47 0 0 0-.06.53c.1.18.25.27.46.27h7.96c.21 0 .37-.1.46-.28.09-.18.07-.35-.07-.52l-2.42-3.17a.48.48 0 0 0-.4-.2c-.17 0-.3.06-.4.2l-1.9 2.47ZM8 18c-.55 0-1.02-.2-1.41-.59-.4-.39-.59-.86-.59-1.41V4c0-.55.2-1.02.59-1.41C6.98 2.19 7.45 2 8 2h12c.55 0 1.02.2 1.41.59.4.39.59.86.59 1.41v12c0 .55-.2 1.02-.59 1.41-.39.4-.86.59-1.41.59H8Zm-4 4c-.55 0-1.02-.2-1.41-.59-.4-.39-.59-.86-.59-1.41V7c0-.28.1-.52.29-.71.19-.2.43-.29.71-.29.28 0 .52.1.71.29.2.19.29.43.29.71v13h13c.28 0 .52.1.71.29.2.19.29.43.29.71 0 .28-.1.52-.29.71A.94.94 0 0 1 17 22H4Z"/></svg></span><span>Photos &amp; videos</span></button>
                                <button type="button" class="attach-option" role="menuitem" onclick="openAttachCamera()"><span class="attach-glyph" style="color:#ff2e74"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 17.5c1.25 0 2.31-.44 3.19-1.31A4.34 4.34 0 0 0 16.5 13c0-1.25-.44-2.31-1.31-3.19A4.34 4.34 0 0 0 12 8.5c-1.25 0-2.31.44-3.19 1.31A4.34 4.34 0 0 0 7.5 13c0 1.25.44 2.31 1.31 3.19A4.34 4.34 0 0 0 12 17.5Zm0-2c-.7 0-1.3-.24-1.78-.72A2.41 2.41 0 0 1 9.5 13c0-.7.24-1.3.72-1.78A2.41 2.41 0 0 1 12 10.5a2.44 2.44 0 0 1 2.5 2.5 2.44 2.44 0 0 1-2.5 2.5ZM4 21c-.55 0-1.02-.2-1.41-.59-.4-.39-.59-.86-.59-1.41V7c0-.55.2-1.02.59-1.41C2.98 5.19 3.45 5 4 5h3.15L8.4 3.65A2 2 0 0 1 9.87 3h4.26a2 2 0 0 1 1.47.65L16.85 5H20c.55 0 1.02.2 1.41.59.4.39.59.86.59 1.41v12c0 .55-.2 1.02-.59 1.41-.39.4-.86.59-1.41.59H4Z"/></svg></span><span>Camera</span></button>
                                <button type="button" class="attach-option" role="menuitem" onclick="pickAttachment('audio')"><span class="attach-glyph" style="color:#ff8a3d"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 21H5c-.55 0-1.02-.2-1.41-.59-.4-.39-.59-.86-.59-1.41v-7c0-1.25.24-2.42.71-3.51A9.15 9.15 0 0 1 8.5 3.7 8.7 8.7 0 0 1 12 3a8.7 8.7 0 0 1 3.51.71A9.15 9.15 0 0 1 20.3 8.5 8.7 8.7 0 0 1 21 12v7c0 .55-.2 1.02-.59 1.41-.39.4-.86.59-1.41.59h-2c-.55 0-1.02-.2-1.41-.59-.4-.39-.59-.86-.59-1.41v-4c0-.55.2-1.02.59-1.41.39-.4.86-.59 1.41-.59h2v-1c0-1.95-.68-3.6-2.04-4.96A6.75 6.75 0 0 0 12 5c-1.95 0-3.6.68-4.96 2.04A6.75 6.75 0 0 0 5 12v1h2c.55 0 1.02.2 1.41.59.4.39.59.86.59 1.41v4c0 .55-.2 1.02-.59 1.41-.39.4-.86.59-1.41.59Z"/></svg></span><span>Audio</span></button>
                                <button type="button" class="attach-option" role="menuitem" onclick="openShareContact()"><span class="attach-glyph" style="color:#009de2"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 12c-1.1 0-2.04-.4-2.82-1.18A3.85 3.85 0 0 1 8 8c0-1.1.4-2.04 1.18-2.83A3.85 3.85 0 0 1 12 4c1.1 0 2.04.4 2.82 1.17A3.85 3.85 0 0 1 16 8c0 1.1-.4 2.04-1.18 2.82A3.85 3.85 0 0 1 12 12Zm-6 8c-.55 0-1.02-.2-1.41-.59-.4-.39-.59-.86-.59-1.41v-.8c0-.57.15-1.09.44-1.56a2.9 2.9 0 0 1 1.16-1.09 13.76 13.76 0 0 1 9.65-1.16c1.07.26 2.12.64 3.15 1.16.48.25.87.61 1.16 1.09.3.47.44 1 .44 1.56v.8c0 .55-.2 1.02-.59 1.41-.39.4-.86.59-1.41.59H6Z"/></svg></span><span>Contact</span></button>
                            </div>
                        </div>
                        <input id="attachment-file-input" type="file" class="visually-hidden" />
                        <button id="emoji-toggle-btn" type="button" class="icon-btn" onclick="toggleEmojiPicker()" title="Emoji"><i data-lucide="smile"></i></button>
                        <div class="composer-field">
                            <textarea id="composer-input" rows="1" class="composer-input" maxlength="10000" aria-label="Type a message" placeholder="Type a message"></textarea>
                        </div>
                        <button id="send-btn" type="button" class="send-btn" disabled title="Send">
                            <i data-lucide="send"></i>
                        </button>
                        <button id="voice-record-btn" type="button" class="icon-btn voice-record-btn" onclick="startVoiceRecording()" aria-label="Record voice message" title="Record voice message"><i data-lucide="mic"></i></button>
                    </div>
                </div>
            </div>
        </section>
        @await Html.PartialAsync("_MessageInfo")
    </div>
</div>

<div id="msg-context-menu" class="ctx-menu message-menu hidden" aria-label="Message actions">
    <div class="ctx-react" role="group" aria-label="Quick reactions">
        <button type="button" onclick="messageAction('reaction','👍')" aria-label="React with thumbs up">👍</button>
        <button type="button" onclick="messageAction('reaction','❤️')" aria-label="React with heart">❤️</button>
        <button type="button" onclick="messageAction('reaction','😂')" aria-label="React with laughter">😂</button>
        <button type="button" onclick="messageAction('reaction','😮')" aria-label="React with surprise">😮</button>
        <button type="button" onclick="messageAction('reaction','😢')" aria-label="React with sadness">😢</button>
        <button type="button" onclick="messageAction('reaction','🙏')" aria-label="React with thanks">🙏</button>
        <button type="button" onclick="messageAction('more-reactions')" aria-label="More reactions"><i data-lucide="plus"></i></button>
    </div>
    <div class="message-menu-items" role="menu" aria-label="Message options">
        <button type="button" class="ctx-item" role="menuitem" data-message-action="info" onclick="messageAction('info')"><i data-lucide="info"></i><span>Message info</span></button>
        <button type="button" class="ctx-item" role="menuitem" data-message-action="reply" onclick="messageAction('reply')"><i data-lucide="reply"></i><span>Reply</span></button>
        <button id="menu-copy-btn" type="button" class="ctx-item" role="menuitem" data-message-action="copy" onclick="messageAction('copy')"><i data-lucide="copy"></i><span>Copy</span></button>
        <button type="button" class="ctx-item" role="menuitem" data-message-action="react" onclick="messageAction('react')"><i data-lucide="smile"></i><span>React</span></button>
        <button type="button" class="ctx-item" role="menuitem" data-message-action="forward" onclick="messageAction('forward')"><i data-lucide="forward"></i><span>Forward</span></button>
        <button id="menu-pin-btn" type="button" class="ctx-item" role="menuitem" data-message-action="pin" onclick="messageAction('pin')"><i data-lucide="pin"></i><span>Pin</span></button>
        <button id="menu-star-btn" type="button" class="ctx-item" role="menuitem" data-message-action="star" onclick="messageAction('star')"><i data-lucide="star"></i><span>Star</span></button>
        <button type="button" class="ctx-item" role="menuitem" data-message-action="note" onclick="messageAction('note')"><i data-lucide="notebook-pen"></i><span>Add text to note</span></button>
        <button id="menu-edit-btn" type="button" class="ctx-item" role="menuitem" data-message-action="edit" onclick="messageAction('edit')"><i data-lucide="pencil"></i><span>Edit</span></button>
        <div class="message-menu-divider" role="separator"></div>
        <button id="menu-delete-btn" type="button" class="ctx-item is-danger" role="menuitem" data-message-action="delete" onclick="messageAction('delete')"><i data-lucide="trash-2"></i><span>Delete</span></button>
    </div>
</div>

@await Html.PartialAsync("_MessageActions")


<div id="new-chat-modal" class="modal-layer hidden">
    <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="new-chat-title">
        <div class="modal-head">
            <h3 id="new-chat-title">New chat</h3>
            <button type="button" class="icon-btn" onclick="closeAllModals()" aria-label="Close">
                <i data-lucide="x"></i>
            </button>
        </div>
        <div class="new-group-tools">
            <button type="button" class="ctx-item" onclick="toggleGroupMode()"><i data-lucide="users"></i><span id="group-mode-label">New group</span></button>
            <button type="button" class="ctx-item" onclick="toggleAddContact()"><i data-lucide="user-plus"></i><span id="add-contact-label">Add contact</span></button>
            <button type="button" class="ctx-item" onclick="openMyQr()"><i data-lucide="qr-code"></i><span>My QR code</span></button>
            <button type="button" class="ctx-item" onclick="openQrScanner()"><i data-lucide="scan-line"></i><span>Scan a QR code</span></button>
            <div id="group-fields" class="hidden"><label for="group-title">Group name</label><input id="group-title" class="input" maxlength="100" placeholder="Add a group name" /><button type="button" id="create-group-btn" class="btn btn-primary" onclick="createGroup()" disabled>Create group</button></div>
            <div id="add-contact-fields" class="hidden">
                <label for="add-contact-username">Username</label>
                <input id="add-contact-username" class="input" maxlength="50" autocomplete="off" spellcheck="false" placeholder="Enter their exact username" onkeydown="if(event.key==='Enter'){event.preventDefault();addContactByUsername();}" />
                <button type="button" id="add-contact-btn" class="btn btn-primary" onclick="addContactByUsername()">Add contact</button>
                <p class="add-contact-hint">You need their full username. Search below only lists people you’ve already chatted with.</p>
            </div>
        </div>
        <div class="modal-search">
            <div class="search-field">
                <i data-lucide="search"></i>
                <input type="search" placeholder="Search your contacts" aria-label="Search contacts" oninput="debouncedContactSearch(this.value)" />
            </div>
        </div>
        <div id="new-chat-contacts-list" class="contact-list"></div>
    </div>
</div>

<div id="my-qr-modal" class="modal-layer hidden">
    <div class="modal-card qr-card" role="dialog" aria-modal="true" aria-labelledby="my-qr-title">
        <div class="modal-head">
            <h3 id="my-qr-title">Your QR code</h3>
            <button type="button" class="icon-btn" onclick="closeAllModals()" aria-label="Close">
                <i data-lucide="x"></i>
            </button>
        </div>
        <div class="qr-body">
            <p class="qr-lead">Let someone scan this to message you. They don’t need your number or username.</p>
            <div class="qr-frame">
                <img id="my-qr-image" width="220" height="220" alt="Your contact QR code" />
            </div>
            <p class="qr-identity"><strong id="my-qr-name"></strong><span id="my-qr-user"></span></p>
            <div class="qr-actions">
                <button type="button" class="btn btn-primary" onclick="shareMyQr()">Share code</button>
                <a id="qr-download" class="btn btn-ghost" download="contact-qr.svg">Download</a>
            </div>
        </div>
    </div>
</div>

<div id="scan-qr-modal" class="modal-layer hidden">
    <div class="modal-card qr-card" role="dialog" aria-modal="true" aria-labelledby="scan-qr-title">
        <div class="modal-head">
            <h3 id="scan-qr-title">Scan QR code</h3>
            <button type="button" class="icon-btn" onclick="closeAllModals()" aria-label="Close">
                <i data-lucide="x"></i>
            </button>
        </div>
        <div class="qr-body">
            <div id="qr-viewfinder" class="qr-viewfinder hidden">
                <video id="qr-video" playsinline muted></video>
                <div class="qr-reticle" aria-hidden="true"></div>
            </div>
            <p id="qr-scan-status" class="qr-lead" role="status">Point the camera at a contact QR code.</p>
            <div id="qr-scan-result" class="qr-result hidden"></div>
            <div class="qr-actions">
                <button type="button" class="btn btn-primary" id="qr-start-camera" onclick="startQrCamera()">Start camera</button>
                <label class="btn btn-ghost qr-upload">Use a photo<input id="qr-file" type="file" accept="image/png,image/jpeg,image/webp,image/gif,image/svg+xml" onchange="scanQrFile(this)" /></label>
                <button type="button" class="btn btn-ghost" onclick="openMyQr()"><i data-lucide="qr-code"></i>Show my QR</button>
            </div>
            <canvas id="qr-canvas" class="qr-canvas" aria-hidden="true"></canvas>
        </div>
    </div>
</div>

<div id="camera-modal" class="modal-layer hidden">
    <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="camera-title">
        <div class="modal-head">
            <h3 id="camera-title">Camera</h3>
            <button type="button" class="icon-btn" onclick="closeAllModals()" aria-label="Close"><i data-lucide="x"></i></button>
        </div>
        <div class="attach-form">
            <video id="attach-camera-video" class="attach-camera" autoplay playsinline muted></video>
            <div class="attach-form-actions">
                <button type="button" class="btn btn-primary" onclick="captureAttachPhoto()">Take photo</button>
                <button type="button" class="btn btn-ghost" onclick="pickAttachment('media')">Choose a photo</button>
            </div>
        </div>
    </div>
</div>

<div id="share-contact-modal" class="modal-layer hidden">
    <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="share-contact-title">
        <div class="modal-head">
            <h3 id="share-contact-title">Send contact</h3>
            <button type="button" class="icon-btn" onclick="closeAllModals()" aria-label="Close"><i data-lucide="x"></i></button>
        </div>
        <div class="modal-search">
            <div class="search-field">
                <i data-lucide="search"></i>
                <input type="search" placeholder="Search contacts" aria-label="Search contacts" oninput="queueShareContacts(this.value)" />
            </div>
        </div>
        <div id="share-contact-list" class="contact-list"></div>
    </div>
</div>

<div id="poll-modal" class="modal-layer hidden">
    <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="poll-title">
        <div class="modal-head">
            <h3 id="poll-title">Create poll</h3>
            <button type="button" class="icon-btn" onclick="closeAllModals()" aria-label="Close"><i data-lucide="x"></i></button>
        </div>
        <form class="attach-form" onsubmit="submitPoll(event)">
            <label>Question<input id="poll-question" maxlength="200" required /></label>
            <div id="poll-options"></div>
            <button type="button" class="btn btn-ghost" onclick="addPollOption()">Add option</button>
            <button type="submit" class="btn btn-primary">Send poll</button>
        </form>
    </div>
</div>

<div id="event-modal" class="modal-layer hidden">
    <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="event-title-label">
        <div class="modal-head">
            <h3 id="event-title-label">Create event</h3>
            <button type="button" class="icon-btn" onclick="closeAllModals()" aria-label="Close"><i data-lucide="x"></i></button>
        </div>
        <form class="attach-form" onsubmit="submitEvent(event)">
            <label>Title<input id="event-title" maxlength="120" required /></label>
            <label>Date and time<input id="event-when" type="datetime-local" required /></label>
            <label>Location<input id="event-where" maxlength="120" /></label>
            <label>Details<textarea id="event-detail" maxlength="500"></textarea></label>
            <button type="submit" class="btn btn-primary">Send event</button>
        </form>
    </div>
</div>

<div id="catalogue-modal" class="modal-layer hidden">
    <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="catalogue-title">
        <div class="modal-head">
            <h3 id="catalogue-title">Catalogue</h3>
            <button type="button" class="icon-btn" onclick="closeAllModals()" aria-label="Close"><i data-lucide="x"></i></button>
        </div>
        <div id="catalogue-list" class="contact-list"></div>
        <form class="attach-form" onsubmit="saveCatalogueItem(event)">
            <label>Item<input id="catalogue-name" maxlength="80" required /></label>
            <label>Price<input id="catalogue-price" maxlength="40" placeholder="Optional" /></label>
            <label>Details<textarea id="catalogue-detail" maxlength="240"></textarea></label>
            <button type="submit" class="btn btn-primary">Add to catalogue</button>
        </form>
    </div>
</div>

<div id="replies-modal" class="modal-layer hidden">
    <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="replies-title">
        <div class="modal-head">
            <h3 id="replies-title">Quick replies</h3>
            <button type="button" class="icon-btn" onclick="closeAllModals()" aria-label="Close"><i data-lucide="x"></i></button>
        </div>
        <div id="replies-list" class="contact-list"></div>
        <form class="attach-form" onsubmit="saveQuickReply(event)">
            <label>New reply<textarea id="reply-text" maxlength="1000" required></textarea></label>
            <button type="submit" class="btn btn-primary">Save reply</button>
        </form>
    </div>
</div>

<div id="lightbox-modal" class="modal-layer lightbox hidden" onclick="closeLightbox()">
    <button type="button" class="lightbox-close" onclick="closeLightbox()" aria-label="Close">
        <i data-lucide="x"></i>
    </button>
    <img id="lightbox-image" src="/images/favicon.svg" alt="Preview" onclick="event.stopPropagation()" />
</div>

@await Html.PartialAsync("_SocialFeatures")
@section Scripts {
    <script src="/js/chat-scroll.js" asp-append-version="true" defer></script>
    <script src="/js/message-receipts.js" asp-append-version="true" defer></script>
    <script src="/js/message-info.js" asp-append-version="true" defer></script>
    <script src="/js/jsQR.js" asp-append-version="true" defer></script><script src="/js/chat.js" asp-append-version="true" defer></script><script src="/js/message-actions.js" asp-append-version="true" defer></script><script src="/js/voice-messages.js" asp-append-version="true" defer></script><script src="/js/qr.js" asp-append-version="true" defer></script><script src="/js/features.js" asp-append-version="true" defer></script><script src="/js/calls.js" asp-append-version="true" defer></script>
}

