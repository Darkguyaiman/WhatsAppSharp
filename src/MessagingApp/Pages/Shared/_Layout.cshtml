<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#161717" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="WhatsApp Web" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/images/icons/icon-192.png" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " · " : "")WhatsApp</title>
    <meta name="description" content="WhatsApp for the web. Send and receive messages in real time." />
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg" />
    <link rel="stylesheet" href="/css/app.css" asp-append-version="true" />
    <script>
        (function () {
            var theme; try { theme = localStorage.getItem("wa_theme"); } catch (_) {}
            document.documentElement.classList.add(theme === "light" ? "theme-light" : "theme-dark");
        })();
    </script>
</head>
<body>
    @RenderBody()
    <script src="/js/navigation.js" asp-append-version="true" defer></script>
    <script src="/js/signalr.min.js" defer></script>
    <script src="/js/lucide.min.js" defer></script>
    <script src="/js/twemoji.min.js" defer></script>
    <script src="/js/emoji-catalog.js" asp-append-version="true" defer></script>
    <script src="/js/emoji.js" asp-append-version="true" defer></script>
    <script>
        window.refreshIcons = function (root) {
            if (!window.lucide || typeof lucide.createIcons !== "function") return;
            lucide.createIcons({
                attrs: {
                    "stroke-width": "1.75",
                    width: "22",
                    height: "22"
                },
                nameAttr: "data-lucide",
                root: root || document
            });
        };
        document.addEventListener("DOMContentLoaded", function () {
            window.refreshIcons();
        });
    </script>
    <div id="app-toast" class="app-toast hidden" role="status" aria-live="polite"></div>
    <script src="/js/pwa.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
