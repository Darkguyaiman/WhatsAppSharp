<aside id="message-info-panel" class="message-info-panel" role="region" aria-labelledby="message-info-title" aria-hidden="true" inert>
    <header class="message-info-head">
        <button id="message-info-close" type="button" class="icon-btn" onclick="closeMessageInfo()" aria-label="Back to chat"><i class="info-close-desktop" data-lucide="x"></i><i class="info-close-mobile" data-lucide="arrow-left"></i></button>
        <h2 id="message-info-title">Message info</h2>
    </header>
    <div class="message-info-scroll">
        <div id="message-info-preview" class="message-info-preview"></div>
        <div id="message-info-content" class="message-info-content" aria-live="polite"></div>
    </div>
</aside>
