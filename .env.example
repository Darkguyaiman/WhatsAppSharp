# Copy to .env and fill in local values:
#   copy .env.example .env
#
# ASP.NET Core maps nested config with double underscores.
# Existing process/launchSettings environment variables win over .env.

ASPNETCORE_ENVIRONMENT=Development

# MySQL (required)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=messagingapp_db
MYSQL_USER=root
MYSQL_PASSWORD=YOUR_PASSWORD
MYSQL_CHARSET=utf8mb4

# Google OAuth web application. Redirect URI: http://localhost:5287/signin-google
# Use your actual origin/port and HTTPS origin in production.
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=

# Optional for local push. Leave blank in Development to auto-generate
# keys into App_Data/vapid.protected. Required together in Production.
WebPush__Subject=mailto:you@example.com
WebPush__PublicKey=
WebPush__PrivateKey=

# Production host allow-list (semicolon-separated). Use * only for local experiments.
AllowedHosts=*


# Voice and video calls (optional relay for cross-network calling)
# Separate comma-separated UDP/TCP/TLS TURN URLs. Shared secret stays server-side.
Calls__StunUrls=stun:stun.l.google.com:19302
Calls__TurnUrls=
Calls__TurnSharedSecret=

# Optional hosting settings. The Linux installer manages port and persistent keys.
# For an HTTPS proxy on the same server, set these in the SERVER config:
# Hosting__TrustedProxy=127.0.0.1
# Hosting__UseHttpsRedirection=true
# DataProtection__KeyPath=/var/lib/messagingapp/keys
# DataProtection__ApplicationName=MessagingApp
